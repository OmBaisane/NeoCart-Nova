# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas Cloud Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/neocart_nova?retryWrites=true&w=majority

# Authentication Security (Minimum 32 random characters)
JWT_SECRET=your_super_strong_random_jwt_secret_min_32_chars

# Authorized Client Origin (CORS & CSRF origin validation)
CLIENT_URL=https://your-frontend-app.vercel.app