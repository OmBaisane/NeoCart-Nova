# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Cloud Cluster / Local Development)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/neocart_nova?retryWrites=true&w=majority

# Authentication Security (Minimum 32 random characters in production)
JWT_SECRET=dev_jwt_secret_key_12345_super_secure_32_characters_long

# Authorized Client Origin (CORS & CSRF origin validation)
CLIENT_URL=http://localhost:3000

# Seeder Credentials (Required for npm run seed in development/staging)
SEED_ADMIN_EMAIL=admin@neocart.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_PHONE=9876543210

SEED_DEMO_USER_EMAIL=demo@neocart.local
SEED_DEMO_USER_PASSWORD=DemoPassword123!
SEED_DEMO_USER_PHONE=9876543211