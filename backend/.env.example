# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI placeholder)
MONGO_URI=mongodb://127.0.0.1:27017/neocart_nova

# Authentication Security (Placeholder for 32+ char secret in production)
JWT_SECRET=your_dev_jwt_secret_must_be_32_characters_long_min

# Authorized Client Origin (CORS & CSRF origin validation)
CLIENT_URL=http://localhost:3000

# Seeder Credentials Placeholders (Replace with your own dev credentials in local .env)
SEED_ADMIN_EMAIL=admin_demo@example.com
SEED_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
SEED_ADMIN_PHONE=9876543210

SEED_DEMO_USER_EMAIL=user_demo@example.com
SEED_DEMO_USER_PASSWORD=ReplaceWithStrongPassword123!
SEED_DEMO_USER_PHONE=9876543211